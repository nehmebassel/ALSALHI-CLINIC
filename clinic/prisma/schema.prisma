model AssessmentInstance {
  id                     String   @id @default(uuid()) @db.Uuid
  clinicalInterviewId    String   @db.Uuid
  assessmentDefinitionId String   @db.Uuid
  createdAt              DateTime @default(now())

  clinicalInterview    ClinicalInterview    @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  assessmentDefinition AssessmentDefinition @relation(fields: [assessmentDefinitionId], references: [id], onDelete: Restrict)
  activatedLibraries   ActiveLibrary[]      @relation("ActiveLibrarySourceAssessment")

  @@unique([clinicalInterviewId, assessmentDefinitionId])
  @@index([clinicalInterviewId])
  @@index([assessmentDefinitionId])
}

model ActiveLibrary {
  id                         String               @id @default(uuid()) @db.Uuid
  clinicalInterviewId        String               @db.Uuid
  clinicalLibraryId          String               @db.Uuid
  activationSourceType       ActivationSourceType
  sourceActivePathwayId      String?              @db.Uuid
  sourceRuleVersionId        String?              @db.Uuid
  sourceAssessmentInstanceId String?              @db.Uuid
  activatedAt                DateTime             @default(now())

  clinicalInterview        ClinicalInterview   @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  clinicalLibrary          ClinicalLibrary     @relation(fields: [clinicalLibraryId], references: [id], onDelete: Restrict)
  sourceActivePathway      ActivePathway?      @relation("ActiveLibrarySourcePathway", fields: [sourceActivePathwayId], references: [id], onDelete: Restrict)
  sourceRuleVersion        RuleVersion?        @relation("ActiveLibrarySourceRule", fields: [sourceRuleVersionId], references: [id], onDelete: Restrict)
  sourceAssessmentInstance AssessmentInstance? @relation("ActiveLibrarySourceAssessment", fields: [sourceAssessmentInstanceId], references: [id], onDelete: Restrict)

  @@unique([clinicalInterviewId, clinicalLibraryId])
  @@index([clinicalInterviewId])
  @@index([clinicalLibraryId])
  @@index([activationSourceType])
  @@index([sourceActivePathwayId])
  @@index([sourceRuleVersionId])
  @@index([sourceAssessmentInstanceId])
}

model QuestionInstance {
  id                   String            @id @default(uuid()) @db.Uuid
  clinicalInterviewId  String            @db.Uuid
  questionDefinitionId String            @db.Uuid
  responseScopeType    ResponseScopeType
  responseScopeKey     String
  activatedAt          DateTime          @default(now())
  becameInactiveAt     DateTime?
  createdAt            DateTime          @default(now())

  clinicalInterview         ClinicalInterview          @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  questionDefinition        QuestionDefinition         @relation(fields: [questionDefinitionId], references: [id], onDelete: Restrict)
  response                  Response?
  dualPerspectiveAssessment DualPerspectiveAssessment?
  activationSources         QuestionActivationSource[]

  @@unique([clinicalInterviewId, questionDefinitionId, responseScopeType, responseScopeKey])
  @@index([clinicalInterviewId])
  @@index([questionDefinitionId])
}

model QuestionActivationSource {
  id                 String               @id @default(uuid()) @db.Uuid
  questionInstanceId String               @db.Uuid
  sourceType         ActivationSourceType
  sourceKey          String
  isRequired         Boolean              @default(false)
  createdAt          DateTime             @default(now())

  questionInstance QuestionInstance @relation(fields: [questionInstanceId], references: [id], onDelete: Cascade)

  @@unique([questionInstanceId, sourceType, sourceKey])
  @@index([questionInstanceId])
}

model Response {
  id                 String         @id @default(uuid()) @db.Uuid
  questionInstanceId String         @unique @db.Uuid
  valueJson          Json
  currentSource      ResponseSource
  updatedByUserId    String?        @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  questionInstance     QuestionInstance         @relation(fields: [questionInstanceId], references: [id], onDelete: Restrict)
  updatedBy            User?                    @relation("ResponseUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  repeatableItems      RepeatableResponseItem[]
  clinicianAssessments ClinicianAssessment[]

  @@index([updatedByUserId])
}

model RepeatableResponseItem {
  id              String                @id @default(uuid()) @db.Uuid
  responseId      String                @db.Uuid
  valueJson       Json
  approximateDate DateTime?             @db.Date
  datePrecision   ClinicalDatePrecision @default(UNKNOWN)
  sortOrder       Int
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}

model DualPerspectiveAssessment {
  id                   String    @id @default(uuid()) @db.Uuid
  questionInstanceId   String    @unique @db.Uuid
  patientValueJson     Json?
  physicianValueJson   Json?
  effectiveValueJson   Json?
  effectiveValueSource String?
  assessedByUserId     String?   @db.Uuid
  assessedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  questionInstance QuestionInstance @relation(fields: [questionInstanceId], references: [id], onDelete: Restrict)
  assessedBy       User?            @relation("DualPerspectiveAssessedBy", fields: [assessedByUserId], references: [id], onDelete: Restrict)

  @@index([assessedByUserId])
}

model RuleVersion {
  id             String   @id @default(uuid()) @db.Uuid
  code           String
  version        String
  ruleType       String
  definitionJson Json
  createdAt      DateTime @default(now())

  contentVersions              ContentVersionRuleVersion[]
  routingEvaluations           RoutingEvaluation[]
  outputEligibilityEvaluations OutputEligibilityEvaluation[]
  activatedLibraries           ActiveLibrary[]               @relation("ActiveLibrarySourceRule")

  @@unique([code, version])
  @@index([ruleType])
}

model RoutingEvaluation {
  id                  String              @id @default(uuid()) @db.Uuid
  clinicalInterviewId String              @db.Uuid
  ruleVersionId       String              @db.Uuid
  resultState         RuleEvaluationState
  resultJson          Json?
  evaluatedAt         DateTime            @default(now())

  clinicalInterview ClinicalInterview @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  ruleVersion       RuleVersion       @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@index([clinicalInterviewId])
  @@index([ruleVersionId])
  @@index([evaluatedAt])
}

model OutputEligibilityEvaluation {
  id                  String   @id @default(uuid()) @db.Uuid
  clinicalInterviewId String   @db.Uuid
  ruleVersionId       String?  @db.Uuid
  outputType          String
  entityType          String?
  entityId            String?
  eligible            Boolean
  evaluatedAt         DateTime @default(now())

  clinicalInterview ClinicalInterview @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  ruleVersion       RuleVersion?      @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@index([clinicalInterviewId])
  @@index([ruleVersionId])
  @@index([outputType])
  @@index([eligible])
}

model ReviewItem {
  id                  String    @id @default(uuid()) @db.Uuid
  clinicalInterviewId String    @db.Uuid
  entityType          String
  entityId            String
  note                String?
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?   @db.Uuid

  clinicalInterview ClinicalInterview @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  resolvedBy        User?             @relation("ReviewItemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicalInterviewId])
  @@index([resolvedAt])
  @@index([entityType, entityId])
}

model ClinicianAssessment {
  id                  String   @id @default(uuid()) @db.Uuid
  clinicalInterviewId String   @db.Uuid
  responseId          String?  @db.Uuid
  assessmentType      String
  valueJson           Json?
  note                String?
  createdByUserId     String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinicalInterview ClinicalInterview @relation(fields: [clinicalInterviewId], references: [id], onDelete: Restrict)
  response          Response?         @relation(fields: [responseId], references: [id], onDelete: Restrict)
  createdBy         User              @relation("ClinicianAssessmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([clinicalInterviewId])
  @@index([responseId])
  @@index([createdByUserId])
}

model HairHistoryDraft {
  id                 String                  @id @default(uuid()) @db.Uuid
  patientId          String                  @unique @db.Uuid
  sourceVisitId      String                  @db.Uuid
  status             HairHistoryReviewStatus @default(PATIENT_REPORTED_PREVIEW)
  baseRevision       Int                     @default(0)
  lastEditedByUserId String?                 @db.Uuid
  lastEditedAt       DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  patient      Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  sourceVisit  Visit                  @relation("HairHistoryDraftSourceVisit", fields: [sourceVisitId], references: [id], onDelete: Restrict)
  lastEditedBy User?                  @relation("HairHistoryDraftEditedBy", fields: [lastEditedByUserId], references: [id], onDelete: Restrict)
  items        HairHistoryDraftItem[]

  @@index([sourceVisitId])
  @@index([lastEditedByUserId])
  @@index([status])
}

model HairHistoryDraftItem {
  id                 String                @id @default(uuid()) @db.Uuid
  hairHistoryDraftId String                @db.Uuid
  layer              HairHistoryLayer
  itemType           String
  labelAr            String
  labelEn            String
  valueJson          Json
  approximateDate    DateTime?             @db.Date
  datePrecision      ClinicalDatePrecision @default(UNKNOWN)
  source             HairHistoryItemSource @default(PATIENT)
  sourceQuestionCode String?
  sourceScopeKey     String?
  sourceResponseId   String?               @db.Uuid
  sourceItemIndex    Int?
  isIncluded         Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  hairHistoryDraft HairHistoryDraft @relation(fields: [hairHistoryDraftId], references: [id], onDelete: Cascade)

  @@index([hairHistoryDraftId])
  @@index([layer])
  @@index([approximateDate])
  @@index([sourceQuestionCode])
}

model ApprovedHairHistory {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @unique @db.Uuid
  approvedByUserId String   @db.Uuid
  approvedVisitId  String   @db.Uuid
  approvedAt       DateTime
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  approvedBy    User              @relation("HairHistoryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedVisit Visit             @relation(fields: [approvedVisitId], references: [id], onDelete: Restrict)
  items         HairHistoryItem[]

  @@index([approvedVisitId])
  @@index([approvedByUserId])
}

model HairHistoryItem {
  id                    String                @id @default(uuid()) @db.Uuid
  approvedHairHistoryId String                @db.Uuid
  itemType              String
  valueJson             Json
  approximateDate       DateTime?             @db.Date
  datePrecision         ClinicalDatePrecision @default(UNKNOWN)
  source                String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  approvedHairHistory ApprovedHairHistory @relation(fields: [approvedHairHistoryId], references: [id], onDelete: Cascade)

  @@index([approvedHairHistoryId])
  @@index([itemType])
}

model PhysicianHairJourney {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @unique @db.Uuid
  startedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  measurements   Measurement[]
  timelineEvents TimelineEvent[]
  mediaAssets    MediaAsset[]
}

model MeasurementDefinition {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  nameAr   String
  nameEn   String
  unitCode String?
  isActive Boolean @default(true)

  measurements Measurement[]
}

model Measurement {
  id                      String   @id @default(uuid()) @db.Uuid
  physicianHairJourneyId  String   @db.Uuid
  recordedInVisitId       String   @db.Uuid
  recordedByUserId        String   @db.Uuid
  measurementDefinitionId String   @db.Uuid
  value                   Decimal
  measurementDate         DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  physicianHairJourney  PhysicianHairJourney  @relation(fields: [physicianHairJourneyId], references: [id], onDelete: Restrict)
  recordedInVisit       Visit                 @relation("MeasurementRecordedInVisit", fields: [recordedInVisitId], references: [id], onDelete: Restrict)
  recordedBy            User                  @relation("MeasurementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  measurementDefinition MeasurementDefinition @relation(fields: [measurementDefinitionId], references: [id], onDelete: Restrict)

  @@index([physicianHairJourneyId])
  @@index([recordedInVisitId])
  @@index([measurementDefinitionId])
  @@index([measurementDate])
}

model TimelineEvent {
  id                     String                @id @default(uuid()) @db.Uuid
  physicianHairJourneyId String                @db.Uuid
  recordedInVisitId      String                @db.Uuid
  recordedByUserId       String                @db.Uuid
  type                   TimelineEventType
  title                  String?
  description            String?
  valueJson              Json?
  eventDate              DateTime?             @db.Date
  eventDatePrecision     ClinicalDatePrecision @default(UNKNOWN)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  physicianHairJourney PhysicianHairJourney @relation(fields: [physicianHairJourneyId], references: [id], onDelete: Restrict)
  recordedInVisit      Visit                @relation("TimelineEventRecordedInVisit", fields: [recordedInVisitId], references: [id], onDelete: Restrict)
  recordedBy           User                 @relation("TimelineEventRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([physicianHairJourneyId])
  @@index([recordedInVisitId])
  @@index([type])
  @@index([eventDate])
  @@index([eventDatePrecision])
}

model MediaTypeDefinition {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  nameAr   String
  nameEn   String
  isActive Boolean @default(true)

  mediaAssets MediaAsset[]
}

model MediaAsset {
  id                     String               @id @default(uuid()) @db.Uuid
  patientId              String               @db.Uuid
  recordedInVisitId      String?              @db.Uuid
  physicianHairJourneyId String?              @db.Uuid
  recordedByUserId       String               @db.Uuid
  mediaTypeDefinitionId  String               @db.Uuid
  category               MediaCategory        @default(OTHER)
  storageProvider        MediaStorageProvider @default(LOCAL)
  storageKey             String               @unique
  originalFilename       String?
  mimeType               String?
  sizeBytes              Int?
  capturedAt             DateTime?
  createdAt              DateTime             @default(now())

  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedInVisit      Visit?                @relation("MediaRecordedInVisit", fields: [recordedInVisitId], references: [id], onDelete: Restrict)
  physicianHairJourney PhysicianHairJourney? @relation(fields: [physicianHairJourneyId], references: [id], onDelete: Restrict)
  recordedBy           User                  @relation("MediaRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  mediaTypeDefinition  MediaTypeDefinition   @relation(fields: [mediaTypeDefinitionId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([recordedInVisitId])
  @@index([physicianHairJourneyId])
  @@index([mediaTypeDefinitionId])
  @@index([category])
  @@index([capturedAt])
}

model GeneratedOutput {
  id               String   @id @default(uuid()) @db.Uuid
  visitId          String   @db.Uuid
  contentVersionId String   @db.Uuid
  outputType       String
  contentJson      Json
  sourceMetaJson   Json?
  generatorVersion String?
  generatedAt      DateTime @default(now())

  visit          Visit          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  contentVersion ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@index([contentVersionId])
  @@index([outputType])
  @@index([generatedAt])
}

model AuditLog {
  id              String      @id @default(uuid()) @db.Uuid
  patientId       String?     @db.Uuid
  entityType      String
  entityId        String
  fieldName       String?
  action          AuditAction
  oldValueJson    Json?
  newValueJson    Json?
  changedByUserId String?     @db.Uuid
  changedAt       DateTime    @default(now())
  reason          String?

  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)
  changedBy User?    @relation("AuditChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([entityType, entityId])
  @@index([changedByUserId])
  @@index([changedAt])
}
