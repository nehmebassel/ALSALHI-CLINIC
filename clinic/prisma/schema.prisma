// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  MARRIED
  NOT_MARRIED
}

enum ExternalIdentifierType {
  CLINIC_MRN
}

enum ClinicDeviceStatus {
  APPROVED
  REVOKED
}

enum PatientSessionStatus {
  ACTIVE
  LOCKED
  EXPIRED
  CLOSED
}

enum PatientSessionCloseReason {
  CANCELLED
  SUBMITTED
}

enum ResponseSource {
  PATIENT
  PHYSICIAN
}

enum ClinicalDatePrecision {
  DAY
  MONTH
  YEAR
  UNKNOWN
}

enum DraftInterviewStatus {
  DRAFT
  SUBMITTED
  CANCELLED
  EXPIRED
}

enum VisitStatus {
  CREATED
  COMPLETED
  CANCELLED
}

enum PhysicianVisitRecordStatus {
  DRAFT
  FINALIZED
}

enum PhysicianVisitAddendumType {
  CORRECTION
  CLARIFICATION
  ADDITIONAL_DOCUMENTATION
}

enum PhysicianHairPullResult {
  POSITIVE
  NEGATIVE
  NOT_RECORDED
}

enum PhysicianHairPartingFinding {
  UNIVERSAL
  FRONTAL_THINNER
  CROWN_THINNER
  VERTEX_THINNER
}

enum PhysicianVisitMeasurementCode {
  SHEDDING
  DENSITY_LOSS
  ITCH
  BURNING
  SCALP_PAIN
}

enum PhysicianTrichoscopyFindingCode {
  VELLUS_HAIRS
  CORKSCREW_HAIRS
  ANISOTRICHOSIS
  EXCLAMATION_TAPERING_HAIRS
  SINGLE_HAIR_FOLLICULAR_UNITS
  COUDABILITY_HAIRS
  YELLOW_DOTS
  PIGTAIL_CIRCLE_HAIRS
  FOLLICULAR_PLUGS
  UPRIGHT_REGROWING_HAIRS
  PUSTULES
  PERIFOLLICULAR_SCALE
  BLACK_DOTS
  PERIFOLLICULAR_ERYTHEMA
  RED_DOTS
  INTERFOLLICULAR_SCALES
  FOLLICULAR_DROPOUT
  DYSPIGMENTATION
  PERIPILAR_SIGN
  ARBORIZING_DILATED_BLOOD_VESSELS
  BROKEN_HAIRS
  GLOMERULAR_BLOOD_VESSELS
  V_SIGN
  SERPIGINOUS_BLOOD_VESSELS
  HOOK_HAIRS
  PILI_TORTI
  COILED_HAIRS
  WIGGLY_SQUIGGLY_HAIR
  FLAME_HAIRS
  TRICHOPTILOSIS
  TULIP_HAIRS
  POLYTRICHIA
  COMMA_HAIRS
  MILKY_WHITE_STRUCTURELESS_AREAS
  ZIGZAG_HAIRS
}

enum PhysicianAnatomicalMapView {
  FRONT
  TOP
  RIGHT_SIDE
  LEFT_SIDE
}

enum PhysicianAnatomicalRegionCode {
  FRONTAL_SCALP
  MID_SCALP
  VERTEX_CROWN
  RIGHT_TEMPORAL
  LEFT_TEMPORAL
  RIGHT_PARIETAL
  LEFT_PARIETAL
  RIGHT_OCCIPITAL
  LEFT_OCCIPITAL
}

enum PhysicianDiagnosisDecisionAction {
  ADD
  REVISE
  RESOLVE
}

enum PhysicianTreatmentDecisionAction {
  START
  CONTINUE_EXISTING
  MODIFY
  STOP
}

enum PhysicianProcedureDecisionAction {
  PLAN
  PERFORM
  CANCEL_OR_DEFER
}

enum PhysicianProcedureCode {
  PRP
  MICRONEEDLING
  HAIR_LASER
  RED_LIGHT
  MINOXIDIL_INJ
  DUTASTERIDE_INJ
  EXOSOME
  CORTISONE_INJ
  REGENERA
  ACELL
  HAIR_TRANSPLANT
  OTHER
}

enum PatientContextValueKind {
  SCALAR
  STRUCTURED
  LIST
}

enum PatientContextSource {
  PATIENT_REPORTED
}

enum PhysicianMcuFvBasic {
  L
  M0
  M1
  M2
  M3
  C0
  C1
  C2
  C3
  U1
  U2
  U3
}

enum PhysicianMcuFvFrontal {
  F1
  F2
  F3
}

enum PhysicianMcuFvVertex {
  V1
  V2
  V3
}

enum VisitType {
  INITIAL
  FOLLOW_UP
}

enum ClinicalEpisodeStatus {
  ACTIVE
  CLOSED
}

enum VisitReasonRole {
  PRIMARY
  ADDITIONAL
}

enum ClinicalInterviewStatus {
  UNDER_REVIEW
  COMPLETED
}

enum ActivationSourceType {
  SYSTEM
  PATHWAY
  RULE
  ASSESSMENT
  VISIT_REASON
  PROCEDURE_SELECTION
  LASER_SERVICE_SELECTION
  PHYSICIAN_REVIEW_REQUIREMENT
}

enum QuestionResponseType {
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  LONG_TEXT
  NUMBER
  INTEGER
  DATE
  MONTH_YEAR
  YEAR
  SCALE
}

enum ResponseScopeType {
  VISIT
  PATHWAY
  MODULE
  PROCEDURE_SELECTION
  LASER_SERVICE_SELECTION
  MEDICATION_ITEM
  CONDITION_ITEM
  SYMPTOM_ITEM
  EVENT_ITEM
  BODY_AREA
  VISUAL_CLASSIFICATION
}

enum QuestionDefinitionStatus {
  APPROVED
  DRAFT
  RETIRED
  ARCHIVE_ONLY
}

enum RuleEvaluationState {
  TRUE
  FALSE
  UNKNOWN
  PENDING
  CONFIGURATION_ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  SUBMIT
  CANCEL
  EXPIRE
  REACTIVATE
  ACCESS_DENIED
  PHYSICIAN_VISIT_DRAFT_STARTED
  PHYSICIAN_VISIT_DRAFT_UPDATED
  PHYSICIAN_ENCOUNTER_BEGAN
  PHYSICIAN_VISIT_FINALIZED
  PHYSICIAN_VISIT_LATE_FINALIZED
  PHYSICIAN_VISIT_ADDENDUM_ADDED
  PHYSICIAN_CLINICAL_CORRECTION
  PATIENT_CONTEXT_REVIEWED
  PATIENT_CONTEXT_RECONCILED
}

enum HairHistoryReviewStatus {
  PATIENT_REPORTED_PREVIEW
  REVIEWED_DRAFT
  AMENDMENT_DRAFT
}

enum HairHistoryLayer {
  MEASURES
  SYMPTOMS
  TREATMENTS
  PROCEDURES
  TRIGGERS
  DIAGNOSES
  TESTS_LABS
  PHOTOS
}

enum HairHistoryItemSource {
  PATIENT
  PHYSICIAN
}

enum MediaStorageProvider {
  LOCAL
}

enum MediaCategory {
  BASELINE
  FOLLOW_UP
  PROCEDURE
  OTHER
}

enum TimelineEventType {
  MEDICATION
  PROCEDURE
  LAB
  DIAGNOSIS
  TRIGGER
  OTHER
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())

  users User[]
}

model ClinicScope {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices                 ClinicDevice[]
  externalIdentifiers     ExternalPatientIdentifier[]
  invitations             InterviewInvitation[]
  authenticatedSessions   AuthenticatedUserSession[]
  clinicalEpisodes        ClinicalEpisode[]
  visits                  Visit[]
  physicianDiagnoses      PhysicianDiagnosis[]
  physicianTreatments     PhysicianTreatmentCourse[]
  physicianProcedurePlans PhysicianProcedurePlan[]
}

model ClinicDevice {
  id                         String             @id @default(uuid()) @db.Uuid
  clinicScopeId              String             @db.Uuid
  name                       String
  certificateFingerprintHash String             @unique
  status                     ClinicDeviceStatus @default(APPROVED)
  approvedAt                 DateTime?
  revokedAt                  DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  clinicScope           ClinicScope                @relation(fields: [clinicScopeId], references: [id], onDelete: Restrict)
  authenticatedSessions AuthenticatedUserSession[]

  @@index([clinicScopeId, status])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  roleId       String   @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdInvitations             InterviewInvitation[]            @relation("InvitationCreatedBy")
  reviewedClinicalInterviews     ClinicalInterview[]              @relation("InterviewReviewedBy")
  updatedResponses               Response[]                       @relation("ResponseUpdatedBy")
  assessedDualPerspectives       DualPerspectiveAssessment[]      @relation("DualPerspectiveAssessedBy")
  resolvedReviewItems            ReviewItem[]                     @relation("ReviewItemResolvedBy")
  clinicianAssessments           ClinicianAssessment[]            @relation("ClinicianAssessmentCreatedBy")
  approvedHairHistories          ApprovedHairHistory[]            @relation("HairHistoryApprovedBy")
  editedHairHistoryDrafts        HairHistoryDraft[]               @relation("HairHistoryDraftEditedBy")
  recordedMeasurements           Measurement[]                    @relation("MeasurementRecordedBy")
  recordedTimelineEvents         TimelineEvent[]                  @relation("TimelineEventRecordedBy")
  recordedMediaAssets            MediaAsset[]                     @relation("MediaRecordedBy")
  auditLogs                      AuditLog[]                       @relation("AuditChangedBy")
  authenticatedSessions          AuthenticatedUserSession[]
  updatedEpisodeFollowUpProfiles ClinicalEpisodeFollowUpProfile[] @relation("EpisodeFollowUpProfileUpdatedBy")
  preparedPhysicianVisitDrafts   PhysicianVisitRecord[]           @relation("PhysicianVisitDraftStartedBy")
  editedPhysicianVisitDrafts     PhysicianVisitRecord[]           @relation("PhysicianVisitLastDraftEditedBy")
  finalizedPhysicianVisits       PhysicianVisitRecord[]           @relation("PhysicianVisitFinalizedBy")
  physicianVisitAddenda          PhysicianVisitAddendum[]         @relation("PhysicianVisitAddendumAuthor")
  patientContextReviews          PatientContextReview[]           @relation("PatientContextReviewedBy")
  patientContextReconciliations  PatientContextReconciliation[]   @relation("PatientContextReconciledBy")

  @@index([roleId])
  @@index([isActive])
}

model AuthenticatedUserSession {
  id               String    @id @default(uuid()) @db.Uuid
  sessionTokenHash String    @unique
  userId           String    @db.Uuid
  clinicScopeId    String    @db.Uuid
  clinicDeviceId   String?   @db.Uuid
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  clinicScope  ClinicScope   @relation(fields: [clinicScopeId], references: [id], onDelete: Restrict)
  clinicDevice ClinicDevice? @relation(fields: [clinicDeviceId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([clinicScopeId])
  @@index([clinicDeviceId])
}

model Patient {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile                 PatientProfile?
  conditions              Condition[]
  medications             Medication[]
  allergies               Allergy[]
  surgeriesProcedures     SurgeryProcedure[]
  interviewInvitations    InterviewInvitation[]
  visits                  Visit[]
  clinicalEpisodes        ClinicalEpisode[]
  followUpSessionContexts FollowUpSessionContext[]
  hairHistoryDraft        HairHistoryDraft?
  approvedHairHistory     ApprovedHairHistory?
  physicianHairJourney    PhysicianHairJourney?
  mediaAssets             MediaAsset[]
  auditLogs               AuditLog[]
  externalIdentifiers     ExternalPatientIdentifier[]
  patientContextVersions  PatientContextVersion[]
  physicianDiagnoses      PhysicianDiagnosis[]
  physicianTreatments     PhysicianTreatmentCourse[]
  physicianProcedurePlans PhysicianProcedurePlan[]
}

model ExternalPatientIdentifier {
  id              String                 @id @default(uuid()) @db.Uuid
  patientId       String                 @db.Uuid
  clinicScopeId   String                 @db.Uuid
  identifierType  ExternalIdentifierType @default(CLINIC_MRN)
  normalizedValue String
  displayValue    String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicScope ClinicScope @relation(fields: [clinicScopeId], references: [id], onDelete: Restrict)

  @@unique([clinicScopeId, identifierType, normalizedValue])
  @@index([patientId])
}

model PatientProfile {
  id            String        @id @default(uuid()) @db.Uuid
  patientId     String        @unique @db.Uuid
  fullName      String
  gender        Gender
  dateOfBirth   DateTime      @db.Date
  maritalStatus MaritalStatus
  occupation    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([gender])
  @@index([maritalStatus])
}

model Condition {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  name        String
  status      String?
  diagnosedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([name])
}

model Medication {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @db.Uuid
  name      String
  dose      String?
  frequency String?
  startedAt DateTime?
  endedAt   DateTime?
  isCurrent Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([name])
  @@index([isCurrent])
}

model Allergy {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  substance String
  reaction  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([substance])
}

model SurgeryProcedure {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  name        String
  performedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([name])
}

model InterviewInvitation {
  id                          String    @id @default(uuid()) @db.Uuid
  patientId                   String?   @db.Uuid
  clinicScopeId               String    @db.Uuid
  createdByUserId             String    @db.Uuid
  temporaryMrnDisplayValue    String?
  temporaryMrnNormalizedValue String?
  createdAt                   DateTime  @default(now())
  cancelledAt                 DateTime?
  expiresAt                   DateTime?

  patient     Patient?              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicScope ClinicScope           @relation(fields: [clinicScopeId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  session     PatientAccessSession?

  @@index([patientId])
  @@index([clinicScopeId, temporaryMrnNormalizedValue])
  @@index([createdByUserId])
  @@index([expiresAt])
}

model PatientAccessSession {
  id               String                     @id @default(uuid()) @db.Uuid
  invitationId     String                     @unique @db.Uuid
  sessionTokenHash String                     @unique
  status           PatientSessionStatus       @default(ACTIVE)
  closeReason      PatientSessionCloseReason?
  lastActivityAt   DateTime                   @default(now())
  expiresAt        DateTime
  lockedAt         DateTime?
  expiredAt        DateTime?
  closedAt         DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  invitation            InterviewInvitation     @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  draft                 DraftClinicalInterview?
  followUpServerContext FollowUpSessionContext?
}

model DraftClinicalInterview {
  id               String               @id @default(uuid()) @db.Uuid
  sessionId        String               @unique @db.Uuid
  contentVersionId String               @db.Uuid
  patientInputJson Json
  status           DraftInterviewStatus @default(DRAFT)
  expiresAt        DateTime
  submittedAt      DateTime?
  cancelledAt      DateTime?
  purgeAfter       DateTime?
  purgedAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  session        PatientAccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contentVersion ContentVersion       @relation(fields: [contentVersionId], references: [id], onDelete: Restrict)
  visit          Visit?

  @@index([contentVersionId])
  @@index([status])
  @@index([expiresAt])
}

model ClinicalService {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  nameAr   String
  nameEn   String
  isActive Boolean @default(true)

  reasonDefinitions     ReasonForVisitDefinition[]
  pathwayDefinitions    ClinicalPathwayDefinition[]
  assessmentDefinitions AssessmentDefinition[]
}

model ClinicalEpisode {
  id                String                @id @default(uuid()) @db.Uuid
  patientId         String                @db.Uuid
  clinicScopeId     String?               @db.Uuid
  primaryReasonCode String
  status            ClinicalEpisodeStatus @default(ACTIVE)
  openedAt          DateTime              @default(now())
  closedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt

  patient                 Patient                         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicScope             ClinicScope?                    @relation(fields: [clinicScopeId], references: [id], onDelete: Restrict)
  visits                  Visit[]
  followUpProfile         ClinicalEpisodeFollowUpProfile?
  physicianDiagnoses      PhysicianDiagnosis[]
  physicianTreatments     PhysicianTreatmentCourse[]
  physicianProcedurePlans PhysicianProcedurePlan[]

  @@index([patientId, status])
  @@index([patientId, primaryReasonCode])
  @@index([clinicScopeId, status])
}

model FollowUpSessionContext {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @unique @db.Uuid
  patientId      String   @db.Uuid
  contextVersion String
  contextJson    Json
  generatedAt    DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session PatientAccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([generatedAt])
}

model ClinicalEpisodeFollowUpProfile {
  id                        String   @id @default(uuid()) @db.Uuid
  clinicalEpisodeId         String   @unique @db.Uuid
  sourceVisitId             String   @db.Uuid
  updatedByUserId           String   @db.Uuid
  routingJson               Json
  patientVisibleSummaryJson Json
  approvedAt                DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  clinicalEpisode ClinicalEpisode @relation(fields: [clinicalEpisodeId], references: [id], onDelete: Restrict)
  sourceVisit     Visit           @relation("FollowUpProfileSourceVisit", fields: [sourceVisitId], references: [id], onDelete: Restrict)
  updatedBy       User            @relation("EpisodeFollowUpProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([sourceVisitId])
  @@index([updatedByUserId])
  @@index([approvedAt])
}

model FollowUpVisitContext {
  id                String   @id @default(uuid()) @db.Uuid
  visitId           String   @unique @db.Uuid
  sourceVisitId     String?  @db.Uuid
  intent            String
  snapshotJson      Json
  confirmationsJson Json
  patientDeltaJson  Json?
  createdAt         DateTime @default(now())

  visit       Visit  @relation("FollowUpVisit", fields: [visitId], references: [id], onDelete: Restrict)
  sourceVisit Visit? @relation("FollowUpSourceVisit", fields: [sourceVisitId], references: [id], onDelete: Restrict)

  @@index([sourceVisitId])
}

model Visit {
  id                String      @id @default(uuid()) @db.Uuid
  patientId         String      @db.Uuid
  clinicScopeId     String?     @db.Uuid
  sourceDraftId     String      @unique @db.Uuid
  clinicalEpisodeId String?     @db.Uuid
  visitType         VisitType
  status            VisitStatus @default(CREATED)
  visitOccurredAt   DateTime?
  createdAt         DateTime    @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime    @updatedAt

  patient                Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicScope            ClinicScope?           @relation(fields: [clinicScopeId], references: [id], onDelete: Restrict)
  sourceDraft            DraftClinicalInterview @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)
  clinicalEpisode        ClinicalEpisode?       @relation(fields: [clinicalEpisodeId], references: [id], onDelete: Restrict)
  followUpContext        FollowUpVisitContext?  @relation("FollowUpVisit")
  followUpSourceContexts FollowUpVisitContext[] @relation("FollowUpSourceVisit")

  reasons                       VisitReason[]
  aestheticProcedureSelections  VisitAestheticProcedureSelection[]
  laserServiceSelections        VisitLaserServiceSelection[]
  clinicalInterview             ClinicalInterview?
  generatedOutputs              GeneratedOutput[]
  approvedHairHistories         ApprovedHairHistory[]
  hairHistoryDraftSources       HairHistoryDraft[]                 @relation("HairHistoryDraftSourceVisit")
  recordedMeasurements          Measurement[]                      @relation("MeasurementRecordedInVisit")
  recordedTimelineEvents        TimelineEvent[]                    @relation("TimelineEventRecordedInVisit")
  recordedMediaAssets           MediaAsset[]                       @relation("MediaRecordedInVisit")
  followUpProfileSources        ClinicalEpisodeFollowUpProfile[]   @relation("FollowUpProfileSourceVisit")
  physicianVisitRecord          PhysicianVisitRecord?
  patientContextSourceVersions  PatientContextVersion[]            @relation("PatientContextSourceVisit")
  patientContextSourceItems     PatientContextItem[]               @relation("PatientContextItemSourceVisit")
  patientContextReviews         PatientContextReview[]
  patientContextReconciliations PatientContextReconciliation[]
  physicianDiagnosisDecisions   PhysicianDiagnosisDecision[]
  physicianTreatmentDecisions   PhysicianTreatmentDecision[]
  physicianProcedureDecisions   PhysicianProcedureDecision[]

  @@index([patientId])
  @@index([clinicalEpisodeId])
  @@index([clinicScopeId, status])
  @@index([visitType])
  @@index([status])
  @@index([createdAt])
}

model PhysicianVisitRecord {
  id                               String                     @id @default(uuid()) @db.Uuid
  visitId                          String                     @unique @db.Uuid
  status                           PhysicianVisitRecordStatus @default(DRAFT)
  draftJson                        Json
  draftVersion                     Int                        @default(1)
  draftStartedByUserId             String                     @db.Uuid
  draftStartedAt                   DateTime                   @default(now())
  lastDraftEditedByUserId          String                     @db.Uuid
  lastDraftEditedAt                DateTime                   @default(now())
  finalizedByUserId                String?                    @db.Uuid
  finalizedAt                      DateTime?
  finalizedDraftVersion            Int?
  finalizedDraftSha256             String?                    @db.VarChar(64)
  originalFinalizationEvidenceJson Json?
  isLateDocumentation              Boolean                    @default(false)
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt

  visit                Visit                         @relation(fields: [visitId], references: [id], onDelete: Restrict)
  draftStartedBy       User                          @relation("PhysicianVisitDraftStartedBy", fields: [draftStartedByUserId], references: [id], onDelete: Restrict)
  lastDraftEditedBy    User                          @relation("PhysicianVisitLastDraftEditedBy", fields: [lastDraftEditedByUserId], references: [id], onDelete: Restrict)
  finalizedBy          User?                         @relation("PhysicianVisitFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: Restrict)
  addenda              PhysicianVisitAddendum[]
  clinicalExamination  PhysicianClinicalExamination?
  clinicalMeasurements PhysicianVisitMeasurement[]
  patternAssessment    PhysicianPatternAssessment?
  trichoscopy          PhysicianVisitTrichoscopy?
  anatomicalMap        PhysicianVisitAnatomicalMap?
  diagnosisDecisions   PhysicianDiagnosisDecision[]
  treatmentDecisions   PhysicianTreatmentDecision[]
  procedureDecisions   PhysicianProcedureDecision[]

  @@index([status])
  @@index([draftStartedAt])
  @@index([draftStartedByUserId])
  @@index([lastDraftEditedByUserId])
  @@index([finalizedByUserId])
  @@index([finalizedAt])
}

model PhysicianClinicalExamination {
  id                     String                        @id @default(uuid()) @db.Uuid
  physicianVisitRecordId String                        @unique @db.Uuid
  hairPull               PhysicianHairPullResult?
  hairParting            PhysicianHairPartingFinding[] @default([])
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  physicianVisitRecord PhysicianVisitRecord @relation(fields: [physicianVisitRecordId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model PhysicianVisitMeasurement {
  id                     String                        @id @default(uuid()) @db.Uuid
  physicianVisitRecordId String                        @db.Uuid
  code                   PhysicianVisitMeasurementCode
  value                  Int
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  physicianVisitRecord PhysicianVisitRecord @relation(fields: [physicianVisitRecordId], references: [id], onDelete: Restrict)

  @@unique([physicianVisitRecordId, code])
  @@index([physicianVisitRecordId])
  @@index([code])
}

model PhysicianPatternAssessment {
  id                     String                 @id @default(uuid()) @db.Uuid
  physicianVisitRecordId String                 @unique @db.Uuid
  sinclair               Int?
